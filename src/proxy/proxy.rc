#include <winver.h>
#include "chaogarage_release.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CHAOGARAGE_VERSION_RC
 PRODUCTVERSION CHAOGARAGE_VERSION_RC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ChaoGarage project"
            VALUE "FileDescription", "ChaoGarage bootstrap (dinput8 proxy; unofficial, for Sonic & SEGA All-Stars Racing PC)"
            VALUE "FileVersion", CHAOGARAGE_RELEASE_A
            VALUE "InternalName", "ChaoGarage bootstrap"
            VALUE "LegalCopyright", "Original code: MIT License. Contains Microsoft C/C++ runtime code; see THIRD-PARTY-NOTICES."
            VALUE "OriginalFilename", "dinput8.dll"
            VALUE "ProductName", "ChaoGarage"
            VALUE "ProductVersion", CHAOGARAGE_RELEASE_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
